# HyperSABMemory Git Ignore Rules

# Dependencies & Build Outputs
node_modules/
dist/
build/
*.tsbuildinfo

# Local Database & Cache Stores
.hypersabmemory/
.hypermemory/
graphify-out/
*.db
*.sqlite
*.sqlite3

# Environment Files & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Temporary Scratch Files & Logs
scratch/
/.scratch-sprint2-package/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & System Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Generated adapter outputs (written by `hypersabmemory setup` into user repos;
# dogfooding artifacts in this repo — never commit them)
AGENTS.md
CLAUDE.md
.claude.json
.claude/
.mcp.json
.windsurfrules
.cursor/
Memory.md

# Internal planning / research notes
.planning/

# Local scrape dumps (not product source)
2026-08-13_*.json
2026-08-13_*.csv

# Local tooling state (OMO team config, Cursor hook state)
.omo/
.cursor/hooks/


# Per-workspace structural graph index (machine-generated state)
graph.json
GRAPH_REPORT.md

# Playwright MCP session artifacts
.playwright-mcp/

# UI design-tournament artifacts (local only)
.design/

# local npm pack artifacts
*.tgz

# local memory log + generated IDE adapters (machine-local)
/Memory.md
/.claude.json
