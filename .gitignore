# HyperMemory Git Ignore Rules

# Dependencies & Build Outputs
node_modules/
dist/
build/
*.tsbuildinfo

# Local Database & Cache Stores
.hypermemory/
graphify-out/
*.db
*.sqlite
*.sqlite3

# Environment Files & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Temporary Scratch Files & Logs
scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & System Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/mcp.json
.idea/

# Local scrape dumps (not product source)
2026-08-13_*.json
2026-08-13_*.csv

