{
  "name": "hypersabmemory",
  "version": "1.5.0-preview.1",
  "description": "Local-first, source-verifiable MCP context harness and task-continuation memory engine for AI coding agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hypersabmemory": "dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js start",
    "watch": "node dist/cli/index.js watch",
    "mcp": "node dist/cli/index.js mcp",
    "test": "npm run build && vitest run --maxWorkers=2",
    "eval": "vitest run tests/memorybench.test.ts",
    "eval:baseline": "node scripts/retrieval-baseline.mjs",
    "eval:option-b:shadow": "node scripts/option-b-shadow-eval.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "test:upgrade": "node scripts/upgrade-regression.mjs",
    "test:reliability": "node scripts/reliability-stress.mjs",
    "release:candidate": "node scripts/release-candidate.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "prepublishOnly": "npm test && npm run eval && npm run eval:baseline && npm run package:smoke && npm run release:preflight"
  },
  "keywords": [
    "hypersabmemory",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "coding-agent",
    "agent-memory",
    "context-window",
    "context-harness",
    "git-checkpoint",
    "ide",
    "cursor",
    "claude-code",
    "windsurf",
    "vscode"
  ],
  "author": "framesxsab",
  "license": "MIT",
  "homepage": "https://github.com/framesxsab/HyperSABMemory#readme",
  "bugs": {
    "url": "https://github.com/framesxsab/HyperSABMemory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framesxsab/HyperSABMemory.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/eval/repositoryBaseline.*",
    "!dist/eval/repositoryTaskEvaluation.*",
    "!dist/eval/repositoryTaskFixture.*",
    "!dist/eval/sprint25DevelopmentFixture.*",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/AGENT_HANDOFF.md",
    "docs/KNOWN_LIMITATIONS.md"
  ],
  "dependencies": {
    "stemmer": "2.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "12.9.0",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.0.0",
    "vitest": "^4.1.12"
  }
}
