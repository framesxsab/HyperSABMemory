{
  "name": "hypersabmemory",
  "version": "1.4.1",
  "description": "Open-source IDE context harness and persistent memory engine for AI coding agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hypersabmemory": "dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js start",
    "watch": "node dist/cli/index.js watch",
    "mcp": "node dist/cli/index.js mcp",
    "test": "vitest run",
    "eval": "vitest run tests/memorybench.test.ts",
    "prepublishOnly": "npm test && npm run eval && npm run build"
  },
  "keywords": [
    "hypersabmemory",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "coding-agent",
    "agent-memory",
    "context-window",
    "context-harness",
    "git-checkpoint",
    "ide",
    "cursor",
    "claude-code",
    "windsurf",
    "vscode"
  ],
  "author": "framesxsab",
  "license": "MIT",
  "homepage": "https://github.com/framesxsab/HyperSABMemory#readme",
  "bugs": {
    "url": "https://github.com/framesxsab/HyperSABMemory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framesxsab/HyperSABMemory.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
