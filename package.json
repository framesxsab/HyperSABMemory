{
  "name": "hypermemory",
  "version": "1.1.1",
  "description": "Open-source IDE context harness and persistent memory engine inspired by Supermemory and Oh-My-Pi",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hypermemory": "dist/cli/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js start",
    "watch": "node dist/cli/index.js watch",
    "mcp": "node dist/cli/index.js mcp",
    "test": "vitest run",
    "eval": "vitest run tests/memorybench.test.ts",
    "prepublishOnly": "npm test && npm run eval && npm run build"
  },
  "keywords": [
    "hypermemory",
    "supermemory",
    "oh-my-pi",
    "mcp",
    "ide-harness",
    "context-window",
    "ai-agent",
    "git-checkpoint",
    "auto-commit"
  ],
  "author": "HyperMemory Open Source Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framesxsab/HyperMemory.git"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
